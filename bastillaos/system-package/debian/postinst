#!/bin/sh
set -eu

case "${1:-}" in
  configure)
    if ! getent group bastillaos >/dev/null 2>&1; then
      addgroup --system bastillaos
    fi
    if ! getent passwd bastillaos >/dev/null 2>&1; then
      adduser --system --ingroup bastillaos --home /var/lib/bastillaos/system \
        --no-create-home --shell /usr/sbin/nologin bastillaos
    fi
    install -d -o bastillaos -g bastillaos -m 0750 /var/lib/bastillaos/system
    find /var/lib/bastillaos/system -xdev \
      -exec chown --no-dereference bastillaos:bastillaos {} +
    if command -v deb-systemd-helper >/dev/null 2>&1; then
      deb-systemd-helper enable bastillaos-system.service >/dev/null || true
    fi
    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload || true
    fi
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
      # restart (not start) so upgrades replace the running server code
      deb-systemd-invoke restart bastillaos-system.service || true
    fi
    ;;
esac

#DEBHELPER#
exit 0
